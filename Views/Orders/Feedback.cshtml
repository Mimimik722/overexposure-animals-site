@model Feedback
@{
	ViewData["Title"] = "Отзыв";
}
<div class="text-center">
	<div class="row mb-3">
		<div class="col-auto">
			<a class="btn btn-primary text-light" asp-action="Index">Назад</a>
		</div>
	</div>
	<div class="form-label col-form-label">Отзыв о ситтере</div>
	<form method="post">
		<div class="row mb-3">
			<div class="col-auto">
				<label class="form-label">Оценка:</label>
				@for (int i = 1; i <= 10; i++)
					{
						<div class="form-check form-check-inline">
						  <input class="form-check-input" type="radio" name="ratings" id="rating1" value="@i">
						  <label class="form-check-label" for="rating1">@i</label>
						</div>
					}
			</div>
		</div>
		<div class="row mb-3">
			<div class="col-auto">
				<label class="form-label">Комментарий:</label>
				<textarea class="form-control" type="comment" asp-for=Comment></textarea>
			</div>
		</div>
		<input class="btn btn-success" type="submit" value="Отправить"/>
	</form>
</div>
