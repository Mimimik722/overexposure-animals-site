@model ICollection<OrderModel>;
@{
    ViewData["Title"] = "Новый заказы";
    var count = 0;
}
<div class="col-auto">
    <a class="btn btn-primary text-light" asp-controller="Home">Назад</a>
</div>
<div class="text-center h4 mb-3">Новые заказы</div>
<table class="table table-bordered">
    @if (Model.Count != 0)
    {
        <tr>
            <td>№</td>
            <td>Клиент</td>
            <td>Животное</td>
            <td>Тип заказа</td>
            <td>Дата начала</td>
            <td>Дата окончания</td>
            <td>Действия</td>
        </tr>
        foreach (var order in Model)
        {
            count++;
            <tr>
                <td>@count</td>
                <td>@order.Client_.name @order.Client_.surname</td>
                <td>@order.Pet_.name</td>
                <td>@order.Order_Type_.Name</td>
                <td>@order.Date_start</td>
                <td>@order.Date_end</td>
                <td>
                    <a class="btn btn-primary" asp-action="Details" asp-controller="Pets" asp-route-pet="@order.Pet_.id">О животном</a>
                    <a class="btn btn-success" asp-action="Accept" asp-route-order="@order.Id">Принять</a>
                    <a class="btn btn-danger" asp-action="Reject" asp-route-order="@order.Id">Отказаться</a>
                </td>
            </tr>
        }
    }
    else
    {
        <div class="text-center text-muted h6">На данный момент заказов нет</div>
    }
</table>