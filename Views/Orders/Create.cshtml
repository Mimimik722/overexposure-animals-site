@model OrderModel;
@{
	ViewData["Title"] = "Новый заказ";
	int count = 0;
}
<div class="text-left">
	<div class="col-auto">
		<a class="btn btn-primary text-light mb-3" asp-controller="Home" asp-action="Index">Назад</a>
	</div>
	@if (Model.Pet_ == null)
	{
		<div class="form-label col-form-label">Выберите животное:</div>
		<table class="table table-bordered">
			<tr>
				<td>№</td>
				<td>Имя</td>
				<td>Порода</td>
				<td>Пол</td>
				<td>Возраст</td>
				<td>Вес</td>
				<td>Особенности</td>
				<td>Действия</td>
			</tr>
		@foreach (var pet in ViewBag.pets)
		{
			count++;
			<tr>
				<td>@count</td>
				<td>@pet.name</td>
				<td>@pet.breed_.name</td>
				<td>@pet.sex</td>
				<td>@pet.age</td>
				<td>@pet.weight</td>
				<td>@pet.features</td>
				<td>
					<a class="btn btn-primary" asp-action="Create" asp-route-pet_id="@pet.id">Выбрать</a>
				</td>
			</tr>
		}
		</table>
	}
	else if (Model.Sitter_ == null)
	{
		<div class="form-label col-form-label">Выберите ситтера:</div>
		<form method="get" asp-route-pet_id="@Model.Pet_.id">
			<div class="row mb-3">
				<div class="col">
					<div class="row mb-3">
						Стоимость
					</div>
					<div class="row">
						<div class="col">
							<label class="form-label col-auto m-0">От:</label>
							<input class="form-controller" name="payment_from"/>
						</div>
						<div class="col">
							<label class="form-label col-auto m-0">До:</label>
							<input class="form-cotroller" name="payment_to"/>
						</div>
						<input asp-route="pet_id" value="@Model.Pet_.id" name="pet_id" hidden/>
					</div>
				</div>
				<div class="col-auto">
					<input class="btn btn-success" asp-route-pet_id="@Model.Pet_.id" type="submit" value="Применить"/>
				</div>
			</div>
		</form>
		<table class="table table-bordered">
			<tr>
				<td>№</td>
				<td>Рейтинг</td>
				<td>Имя</td>
				<td>Фамилия</td>
				<td>Телефон</td>
				<td>Возраст</td>
				<td>З/п</td>
				<td>Опыт работы</td>
				<td>Действия</td>
			</tr>
		@foreach (var sitter in ViewBag.sitters)
		{
			count++;
			<tr>
			@{
				DateTime zeroTime = new DateTime(1, 1, 1);
				TimeSpan span = DateTime.Now - sitter.user_.birthday.ToDateTime(TimeOnly.Parse("10:00 PM"));
				var years = (zeroTime + span).Year - 1;
			}
				<td>@count</td>
				<td>@ViewBag.ratings[count - 1]</td>
				<td>@sitter.user_.name</td>
				<td>@sitter.user_.surname</td>
				<td>@sitter.user_.telephone</td>
				<td>@years</td>
				<td>@sitter.payment</td>
				<td>@sitter.experience</td>
				<td>
					<a class="btn btn-primary" asp-controller="Sitters" asp-action="Profile" asp-route-sitter_id="@sitter.id">Подробнее</a>
					<a class="btn btn-success" asp-action="Create" asp-route-sitter_id="@sitter.id" asp-route-pet_id="@Model.Pet_.id">Выбрать</a>
				</td>
			</tr>
		}
		</table>
	}
	else
	{
		<form class="form-control" method="post">
			<div class="row mb-3">
			<div class="form-label col-form-label">Заполнител дополнительные поля:</div>
			<div class="row mb-3">
			    <div class="col-auto d-flex align-items-center">
			        <label class="form-label m-0">Ситтер: @Model.Sitter_.user_.name @Model.Sitter_.user_.surname</label>
			    </div>
			<div class="row mb-3">
			    <div class="col-auto d-flex align-items-center">
			        <label class="form-label col-auto m-0">Животное: @Model.Pet_.name</label>
			    </div>
			</div>
			<div class="row mb-3">
			    <div class="col-auto d-flex align-items-center">
			        <label class="form-label m-0">Тип заказа: </label>
			    </div>
			    <div class="form-check form-check-inline col-auto">
			        <input name="Order_type_name" list="Order_types" />
					<datalist id="Order_types">
						@foreach (var order_type in ViewBag.order_types){
							<option value="@order_type.Name"></option>
						}
					</datalist>
			    </div> 
			</div>
			<div class="row align-itemns-center mb-3">
			    <div class="col-auto">
			        <label class="form-label">Дата начала: </label>
			    </div>
			    <div class="col-auto d-flex align-items-center">
			        <input class="form-control" type="date" asp-for=Date_start value="@DateTime.Now"/>
			        <span class="text-danger" asp-validation-for=Date_start></span>
			    </div>
			</div>
			<div class="row align-itemns-center mb-3">
			    <div class="col-auto">
			        <label class="form-label">Дата окончания: </label>
			    </div>
			    <div class="col-auto d-flex align-items-center">
			        <input class="form-control" type="date" asp-for=Date_end value="@DateTime.Now"/>
			        <span class="text-danger" asp-validation-for=Date_end></span>
			    </div>
			</div>
			<input class="btn btn-success" type="submit" value="Создать заказ"/>
		</form>
	}
</div>