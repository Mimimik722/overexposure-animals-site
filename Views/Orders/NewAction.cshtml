@model OrdersHistory;
@{
	ViewData["Title"] = "Новое действие";
}
<div class="col-auto">
	<a class="btn btn-primary text-light mb-3" asp-action="Index">Назад</a>
</div>
<div class="h3 text-center mt-3 mb-3">Новое действие</div>
<form method="post">
	<div class="form-label col-form-label h4">Действие:</div>
	<input class="form-control" asp-for=action/>
	<span class="text-danger" asp-validation-for=action></span>
	<input class="btn btn-success" type="submit" value="Добавить"/>
</form>