@model ICollection<OrderModel>;
@{
    ViewData["Title"] = "Заказы";
    var count = 0;
}
<div class="row justify-content-between">
    <div class="col-1">
        <a class="btn btn-primary text-light" asp-controller="Home">Назад</a>
    </div>
    <div class="col-2 text-end">
        <a class="btn btn-primary text-light" asp-action="Create">Новый заказ</a>
    </div>
</div>
<div class="h3 text-center mt-3 mb-3">Заказы</div>
<table class="table table-bordered">
    <tr>
        <td>№</td>
        <td>Ситтер</td>
        @if (Context.User.IsInRole("Sitter"))
        {
            <td>Клиент</td>
        }
        <td>Животное</td>
        <td>Тип заказа</td>
        <td>Дата начала</td>
        <td>Дата окончания</td>
        <td>Статус</td>
        <td>Оценка</td>
        <td>Действия</td>
    </tr>
    @if (Model != null)
    {
        foreach (var order in Model)
        {
            count++;
            if (!(ViewBag.Statuses[count - 1] == "В ожидании принятия" && User.IsInRole("Sitter")))
            {   
                <tr class="align-middle">
                    <td>@count</td>
                    <td>@order.Sitter_.User_.Name @order.Sitter_.User_.Surname</td>
                    @if (Context.User.IsInRole("Sitter"))
                    {
                        <td>@order.Client_.Name @order.Client_.Surname</td>
                    }
                    <td>@order.Pet_.Name</td>
                    <td>@order.Order_Type_.Name</td>
                    <td>@order.Date_start</td>
                    <td>@order.Date_end</td>
                    <td>@ViewBag.Statuses[count-1]</td>
                    <td>@if (order.Feedback_ != null)
                        {
                            <a>@order.Feedback_.Rating / 10</a>
                            <image class="mb-1" src="/images/star.jpg" width="15rem" height="15rem"></image>
                        }
                    </td>
                    <td>
                        @if (ViewBag.Statuses[count - 1] != "Отменён")
                        {
                            @if (Context.User.IsInRole("User"))
                            {
                                if (ViewBag.Statuses[count - 1] == "Выполнен")
                                {
                                    <a class="btn btn-primary" asp-action="Feedback" asp-route-order="@order.Id">Оставить отзыв</a>
                                }
                                if (ViewBag.Statuses[count - 1] == "Выполняется" && order.Order_Type_.Name == "Прогулка")
                                {
                                    <a class="btn btn-primary" asp-action="Map" asp-route-order="@order.Id">Посмотреть положение</a>
                                }
                                <a class="btn btn-primary" asp-controller="Home" asp-action="Chat" asp-route-user=@long.Parse(order.Sitter_.User_.Telephone)>Чат</a>
                            }
                            else
                            {
                                if (ViewBag.Statuses[count - 1] == "Выполняется")
                                {
                                    <a class="btn btn-success" asp-action="Done" asp-route-order="@order.Id">Выполнен</a>
                                    if(order.Order_Type_.Name == "Прогулка")
                                    {
                                        <a class="btn btn-primary" asp-action="Map" asp-route-order="@order.Id">Посмотреть положение</a>
                                    }
                                }
                                if (ViewBag.Statuses[count - 1] != "Выполнен")
                                {
                                    <a class="btn btn-primary" asp-action="NewAction" asp-route-order="@order.Id">Новое действие</a>
                                }
                                else
                                {
                                    <a class="btn btn-primary" asp-action="Feedback" asp-route-order="@order.Id">Посмотреть отзыв</a>
                                }
                                <a class="btn btn-primary" asp-controller="Home" asp-action="Chat" asp-route-user=@long.Parse(order.Client_.Telephone)>Чат</a>
                            }
                        }
                        <a class="btn btn-primary" asp-action="Actions" asp-route-order="@order.Id">История заказа</a>
                    </td>
                </tr>
            }
        }
    }
    else{
        <div class="text-center h4">У вас пока нет никаких заказов</div>
    }
</table>