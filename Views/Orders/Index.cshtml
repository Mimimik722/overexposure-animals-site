@model ICollection<OrderModel>;
@{
    ViewData["Title"] = "Заказы";
    var count = 0;
}
<div class="row justify-content-between">
    <div class="col-1">
        <a class="btn btn-primary text-light" asp-controller="Home">Назад</a>
    </div>
    <div class="col-2 text-end">
        <a class="btn btn-primary text-light" asp-action="Create">Новый заказ</a>
    </div>
</div>
<div class="h3 text-center mt-3 mb-3">Заказы</div>
<table class="table table-bordered">
    <tr>
        <td>№</td>
        <td>Ситтер</td>
        @if (Context.User.IsInRole("Sitter"))
        {
            <td>Клиент</td>
        }
        <td>Животное</td>
        <td>Тип заказа</td>
        <td>Дата начала</td>
        <td>Дата окончания</td>
        <td>Статус</td>
        <td>Оценка</td>
        <td>Действия</td>
    </tr>
    @if (Model != null)
    {
        foreach (var order in Model)
        {
            count++;
            <tr class="align-middle">
                <td>@count</td>
                <td>@order.Sitter_.user_.name @order.Sitter_.user_.surname</td>
                @if (Context.User.IsInRole("Sitter"))
                {
                    <td>@order.Client_.name @order.Client_.surname</td>
                }
                <td>@order.Pet_.name</td>
                <td>@order.Order_Type_.Name</td>
                <td>@order.Date_start</td>
                <td>@order.Date_end</td>
                <td>@order.Status</td>
                <td>@if (order.Feedback_ != null)
                    {
                        <a>@order.Feedback_.Rating / 10</a>
                        <image class="mb-1" src="/images/star.jpg" width="15rem" height="15rem"></image>
                    }
                </td>
                <td>
                    @if (Context.User.IsInRole("User"))
                    {
                        if (order.Status == "Выполнен")
                        {
                            <a class="btn btn-primary" asp-action="Feedback" asp-route-order_id="@order.Id">Выставить оценку</a>
                        }
                        if (order.Status == "Выполняется" && order.Order_Type_.Name == "Прогулка")
                        {
                            <a class="btn btn-primary" asp-action="Map" asp-route-order_id="@order.Id">Посмотреть положение</a>
                        }
                        <a class="btn btn-primary" asp-action="Chat" asp-route-user_id="@order.Sitter_.user_.id">Чат</a>
                    }
                    else
                    {
                        if (order.Status == "Выполняется")
                        {
                           <a class="btn btn-success" asp-action="Done" asp-route-order_id="@order.Id">Выполнен</a>
                        }
                        <a class="btn btn-primary" asp-action="Chat" asp-route-user_id="@order.Client_.id">Чат</a>
                    }
                </td>
            </tr>
        }
    }
    else{
        <div class="text-center h4">У вас пока нет никаких заказов</div>
    }
</table>