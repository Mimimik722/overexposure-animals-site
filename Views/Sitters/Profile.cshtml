@using Newtonsoft.Json;
@model Project_site.Models.SitterModel;
@{
    ViewData["Title"] = "Детали ситтера";
}

<div class="text-center">
    <div class="row mb-3">
        <div class="col-auto">
            @if (Context.User.IsInRole("User"))
            {
                <a class="btn btn-primary text-light" asp-controller="Orders" asp-action="Create">Назад</a>
            }
            else
            {
                <a class="btn btn-primary text-light" asp-action="Index">Назад</a>
            }
        </div>
        <div class="h4 mb-3">Данные ситтера: @Model.user_.name @Model.user_.surname</div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Имя:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.user_.name</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label col-auto m-0">Фамилия:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.user_.surname</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Рейтинг:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@ViewBag.rating</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Город:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.user_.town_.name</span>
        </div>
    </div>
    <div class="row align-itemns-center mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label">Пол:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.user_.sex</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Дата рождения:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.user_.birthday</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Телефон:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.user_.telephone</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">E-mail:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.user_.email</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Стоимость заказа:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.payment</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-2 d-flex align-items-center">
            <label class="form-label m-0">Опыт работы:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.experience</span>
        </div>
    </div>
</div>