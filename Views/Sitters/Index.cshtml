@model ICollection<SitterModel>;
@{
    ViewData["Title"] = "Ситтеры";
    var count = 0;
}
<div class="row justify-content-between">
    <div class="col-1">
        <a class="btn btn-primary text-light" asp-controller="Home">Назад</a>
    </div>
    <div class="col-1">
        <a class="btn btn-primary text-light" hidden asp-action="Create">Добавить</a>
    </div>
</div>
<div class="text-center h4 mb-3">Ситтеры</div>
<table class="table table-bordered">
    @if (Model.Count != 0)
    {
        <tr>
            <td>№</td>
            <td>Имя</td>
            <td>Фамилия</td>
            <td>Город</td>
            <td>Телефон</td>
            <td>Возраст</td>
            <td>З/п</td>
            <td>Опыт работы</td>
            <td>Действия</td>
        </tr>
        foreach (var sitter in Model)
        {
            count++;
            <tr class="align-middle">
                @{
                    DateTime zeroTime = new DateTime(1, 1, 1);
                    TimeSpan span = DateTime.Now - sitter.User_.Birthday.ToDateTime(TimeOnly.Parse("10:00 PM"));
                    var years = (zeroTime + span).Year - 1;
                }
                <td>@count</td>
                <td>@sitter.User_.Name</td>
                <td>@sitter.User_.Surname</td>
                <td>@sitter.User_.Town_.Name</td>
                <td>@sitter.User_.Telephone</td>
                <td>@years</td>
                <td>@sitter.Payment</td>
                <td>@sitter.Experience</td>
                <td>
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Chat" asp-route-user=int.Parse(@sitter.User_.Telephone)>Чат</a>
                    <a class="btn btn-primary" asp-action="Profile" asp-route-sitter="@sitter.Id">Подробнее</a>
                    <a class="btn btn-danger" asp-action="Remove" asp-route-sitter="@sitter.Id">Уволить</a>
                </td>
            </tr>
        }
    }
    else
    {
        <div class="text-center text-muted">На данный момент нет ни одного ситтера</div>
    }
</table>