@using Newtonsoft.Json;
@using System.Security.Claims;
@{
    ViewData["Title"] = "Профиль";
}
<div class="row mb-3">
    <div class="col-auto">
        <a class="btn btn-primary text-light" asp-action="Edit">Редактировать профиль</a>
    </div>
    <div class="text-center h4">Профиль</div>
</div>
<div class="row">
    <div class="col-4">
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label m-0">Имя:</label>
            </div>
            <div class="col-auto">
                <span class="form-label col m-0">@User.Identity.Name</span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label col-auto m-0">Фамилия:</label>
            </div>
            <div class="col-auto">
                <span class="form-label col m-0">@User.FindFirstValue(ClaimTypes.Surname)</span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label m-0">Город:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="form-label col m-0">@User.FindFirstValue("Town")</span>
            </div>
        </div>
        <div class="row align-itemns-center mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label">Пол:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="form-label col m-0">@User.FindFirstValue(ClaimTypes.Gender)</span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label m-0">Дата рождения:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="form-label col m-0">@User.FindFirstValue(ClaimTypes.DateOfBirth)</span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label m-0">Телефон:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <span class="form-label col m-0">@User.FindFirstValue(ClaimTypes.MobilePhone)</span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label m-0">E-mail:</label>
            </div>
            <div class="col-auto">
                <span class="form-label col m-0">@User.FindFirstValue(ClaimTypes.Email)</span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-5 d-flex align-items-center">
                <label class="form-label m-0">Роль:</label>
            </div>
            <div class="col-auto">
                <span class="form-label col m-0">@User.FindFirstValue(ClaimTypes.Role)</span>
            </div>
        </div>
        @if (Context.User.IsInRole("Sitter"))
        {
            <div class="row mb-3">
                <div class="col-5 d-flex align-items-center">
                    <label class="form-label m-0">Статус:</label>
                </div>
                <div class="col-auto">
                    <span class="form-label col m-0">@ViewBag.status</span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-5 d-flex align-items-center">
                    <label class="form-label m-0">Рейтинг:</label>
                </div>
                <div class="col-auto d-flex align-items-center">
                    <span class="form-label col m-0">@ViewBag.rating</span>
                </div>
            </div>
        }
    </div>
    <div class="col">
        <img src="/User/ProfileImage" class="profile-image image-fulid" alt="Изображение профиля" />
    </div>
</div>