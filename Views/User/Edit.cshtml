@using Newtonsoft.Json
@model Project_site.Models.UserModel;
@{
    ViewData["Title"] = "Профиль";
}
<div class="col-auto mb-2">
    <a class="btn btn-primary text-light" asp-action="Profile">Назад</a>
</div>
<div class="row justify-content-center">
    <div class="col-4">
        <form id="edit" class="form-control" method="Post">
            <div class="h4 mb-4 text-center">Редактирование профиля</div>
            <div class="row mb-3">
                <span class="text-danger" asp-validation-for=name></span>
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label m-0">Имя</label>
                </div>
                <div class="col-auto">
                    <input type="type" class="form-control" asp-for=name placeholder="Иван"/>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label col-auto m-0">Фамилия</label>
                </div>
                <div class="col-auto">
                    <input type="type" class="form-control col" asp-for=surname placeholder="Иванов"/>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label m-0">Город</label>
                </div>
                <div class="col-auto d-flex align-items-center">
                    <input class="form-control m-0" list="townlistOptions" type="list" name="town" placeholder="Введите название города" value="@Model.town_.name" required>
                    <datalist id="townlistOptions">
                                @foreach (var city in @ViewBag.Towns)
                                {
                                <option value="@city.name"></option>
                                }
                    </datalist>
                    <span class="text-danger" asp-validation-for=town_></span>
                </div>
            </div>
            <div class="row align-itemns-center mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label ">Пол</label>
                </div>
                <div class="form-check form-check-inline col-auto ms-4 ps-3">
                            @if (Model.sex == "м")
                            {
                            <input class="form-check-input" type="radio" name="radioM" id="radio1" checked>
                            }
                            else
                            {
                            <input class="form-check-input" type="radio" name="radioM" id="radio1">
                            }
                    <label class="form-check-label" for="radio1">М</label>
                </div> 
                <div class="form-check form-check-inline col-auto">
                            @if (Model.sex == "ж")
                            {
                            <input class="form-check-input" type="radio" name="radioW" id="radio2" checked>
                            }
                            else
                            {
                            <input class="form-check-input" type="radio" name="radioW" id="radio2">
                            }
                    <label class="form-check-label" for="radio2">Ж</label>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label m-0">Дата рождения</label>
                </div>
                <div class="col-auto">
                    <input class="form-control" type="date" asp-for=birthday/>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label m-0">Телефон</label>
                </div>
                <div class="col-auto d-flex align-items-center">
                    <input class="form-control m-0" asp-for=telephone type="tel" placeholder="89008007060">
                    <span class="text-danger" asp-validation-for=telephone></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-4 d-flex align-items-center">
                    <label class="form-label m-0">E-mail</label>
                </div>
                <div class="col-auto">
                    <input class="form-control" asp-for=email type="email" placeholder="Ivan@mail.ru">
                </div>
            </div>
                    @if (Context.User.IsInRole("Sitter"))
                    {
                    <div class="row mb-3">
                        <div class="col-2 d-flex align-items-center">
                            <label class="form-label m-0">Статус</label>
                        </div>
                        <div class="col-auto">
                             <input class="form-control dropdown" type="text" list="statuses" name="status" value="@ViewBag.status"/>
                             <datalist id="statuses">
                                 <option value="Свободен"/>
                                 <option value="Занят"/>
                             </datalist>
                        </div>
                    </div>
                    }
            <div class="text-center">
                <input class="btn btn-success" type="submit" value="Сохранить"/>
            </div>
        </form>
    </div>
</div>