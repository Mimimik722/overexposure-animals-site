@model UserModel
@{
    ViewData["Title"] = "Вход";
}
<div class="row justify-content-center">
    <div class="col-4">
        @if (Model.password == "0")
        {
            <h4>Ошибка. Ссылка недействительна</h4>
        }
        else if (Model.password != "")
        {
            <form class="form-control" method="post">
                <div class="text-center h4">Восстановление пароля</div>
                <div class="row mb-3">
                    <div class="col-auto d-flex align-items-center">
                        <label class="form-label m-0 me-2">Введите новый пароль</label>
                    </div>
                    <div class="col-auto">
                        <input class="form-control" name="password" type="password" placeholder="Пароль" required>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-auto d-flex align-items-center">
                        <label class="form-label m-0 me-2">Повтор пароля</label>
                    </div>
                    <div class="col-auto">
                        <input class="form-control" name="password_repeat" type="password" placeholder="Повтор пароля" required>
                    </div>
                     <span class="text-danger" asp-validation-for=password></span>
                </div>
                <div class="text-center">
                    <input class="btn btn-success" type="submit" value="Сохранить"/>
                </div>
            </form>
        }
        else if (Model.email == "")
        {
            <form class="form-control" method="post">
                <div class="text-center h4">Восстановление пароля</div>
                <div class="row mb-3">
                    <div class="col-auto d-flex align-items-center">
                        <label class="form-label m-0 me-2">Введите email</label>
                    </div>
                    <div class="col-auto">
                        <input class="form-control" asp-for="email" type="email" placeholder="Email" required>
                    </div>
                </div>
                <div class="text-center">
                    <input class="btn btn-success" type="submit" value="Отправить сообщение"/>
                </div>
            </form>
        }
        else
        {
            <h4>На почту @Model.email отправленно с ссылкой на восстановление пароля.</h4>
        }
    </div>
</div>

