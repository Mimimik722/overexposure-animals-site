@using Newtonsoft.Json
@model Project_site.Models.UserModel;
@{
    ViewData["Title"] = "Профиль";
}

<div class="text-center">
    <div class="row mb-3">
        <div class="col-auto">
            <a class="btn btn-primary text-light" asp-action="Edit">Редактировать профиль</a>
        </div>
        <div class="form-label col-form-label">Профиль</div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Имя:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@Model.name</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label col-auto m-0">Фамилия:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@Model.surname</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Город:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@Model.town_.name</span>
        </div>
    </div>
    <div class="row align-itemns-center mb-3">
        <div class="col-auto">
            <label class="form-label">Пол:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@Model.sex</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Дата рождения:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@Model.birthday</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Телефон:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@Model.telephone</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">E-mail:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@Model.email</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Роль:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@ViewBag.role</span>
        </div>
    </div>
</div>