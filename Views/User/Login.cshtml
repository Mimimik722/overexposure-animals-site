@model Project_site.Models.UserModel
@{
    ViewData["Title"] = "Вход";
}
<div class="row justify-content-center">
    <div class="col-4">
        <form id="login" class="form-control" method="post">
        <div class="text-center h4">Вход</div>
        <span class="text-danger" asp-validation-for=Telephone></span>
        <div class="row mb-3 mt-4">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Телефон</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input class="form-control m-0" asp-for=Telephone type="tel" placeholder="89008007060" required value="">
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0 me-2">Пароль</label>
            </div>
            <div class="col-auto">
                <input class="form-control" asp-for=Password type="password" placeholder="Пароль" required>
            </div>
        </div>
        <div class="row mb-3 m-0">
            <input type="checkbox" class="btn-check form-check-input" name="remember-me" id="remember">
            <label class="btn btn-outline-primary col-auto" for="remember">Запомнить меня</label>
        </div>
        <div class="row mb-3">
            <div class="col-auto">
                <a asp-action="Password_reset">Забыл пароль!</a>
            </div>
            <div class="col-auto">
                <a asp-action=Registration>Регистрация</a>
            </div>
        </div>
        <div class="text-center">
            <input class="btn btn-success" type="submit" value="Войти" />
        </div>
        </form>
    </div>
</div>

