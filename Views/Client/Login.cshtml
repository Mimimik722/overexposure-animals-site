@model Project_site.Models.ClientModel
@{
    ViewData["Title"] = "Вход";
}
<div class="text-center">
    <form id="login" class="form-control" method="post">
        <div class="form-label col-form-label">Вход</div>
        <span class="text-danger" asp-validation-for=phone></span>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Телефон</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input class="form-control m-0" asp-for=phone type="tel" placeholder="89008007060" required value="">
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0 me-2">Пароль</label>
            </div>
            <div class="col-auto">
                <input class="form-control" asp-for=password type="password" placeholder="Пароль" required>
            </div>
        </div>
        <div class="row mb-3 m-0">
            <input type="checkbox" class="btn-check form-check-input" name="remember-me" id="remember">
            <label class="btn btn-outline-primary col-3" for="remember">Запомнить меня</label>
        </div>
        <div class="row mb-3">
            <div class="col-auto">
                <a asp-action="Login">Забыл пароль!</a>
            </div>
            <div class="col-auto">
                <a asp-action=Registration>Регистрация</a>
            </div>
        </div>
        <div class="form-check d-flex align-items-left">
            <input type="checkbox" class="form-check-input me-2" name="politacy" id="politacy">
            <label class="form-check-label mb-3" for="politacy">Соглашение об обработке персональных данных</label>
        </div>
        <input class="btn btn-success" type="submit" value="Войти" />
        <br>
    </form>
</div>
