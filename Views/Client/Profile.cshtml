@using Newtonsoft.Json
@model Project_site.Models.ClientModel;
@{
    ViewData["Title"] = "Профиль";
    Client c = JsonConvert.DeserializeObject<Client>(Context.Session.GetString("client"));
    ApplicationContext db = new ApplicationContext();
}

<div class="text-center">
    <div class="row mb-3">
        <div class="col-auto">
            <a class="btn btn-primary text-light" asp-action="Edit">Редактировать профиль</a>
        </div>
        <div class="form-label col-form-label">Профиль</div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Имя:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@c.name</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label col-auto m-0">Фамилия:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@c.surname</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Город:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@db.Towns.Find(c.town_id).name</span>
        </div>
    </div>
    <div class="row align-itemns-center mb-3">
        <div class="col-auto">
            <label class="form-label">Пол:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@c.sex</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Дата рождения:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@c.birthday</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">Телефон:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col">@c.telephone</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-auto d-flex align-items-center">
            <label class="form-label m-0">E-mail:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col">@c.email</span>
        </div>
    </div>
</div>