@model ICollection<PetModel>;
@{
    ViewData["Title"] = "Домашние животные";
    var count = 0;
    ApplicationContext db = new ApplicationContext();
}
<div class="row justify-content-between mb-3">
    <div class="col-auto">
        <a class="btn btn-primary text-light" asp-controller="Home" asp-action="Index">Назад</a>
    </div>
    <div class="col-auto">
        <a class="btn btn-primary text-light" asp-action="Create">Добавить</a>
    </div>
</div>
<div class="text-center h4 mb-3">Домашние животные</div>
<table class="table table-bordered">
    <tr>
        <td>№</td>
        <td>Имя</td>
        <td>Порода</td>
        <td>Пол</td>
        <td>Возраст</td>
        <td>Вес</td>
        <td>Особенности</td>
        <td>Действия</td>
    </tr>
    @if (Model != null)
    {
        foreach (var pet in Model)
        {
            count++;
            <tr class="align-middle">
                <td>@count</td>
                <td>@pet.name</td>
                <td>@pet.breed_.name</td>
                <td>@pet.sex</td>
                <td>@pet.age</td>
                <td>@pet.weight</td>
                <td>@pet.features</td>
                <td>
                    <a class="btn btn-info" asp-action="Details" asp-route-pet_id="@pet.id">Подробнее</a>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-pet_id="@pet.id">Изменить</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-pet_id="@pet.id">Удалить</a>
                </td>
            </tr>
        }
    }
</table>