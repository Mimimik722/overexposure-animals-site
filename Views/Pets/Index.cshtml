@model ICollection<PetModel>;
@{
    ViewData["Title"] = "Домашние животные";
    var count = 0;
}
<div class="row justify-content-between mb-3">
    <div class="col-auto">
        <a class="btn btn-primary text-light" asp-controller="Home" asp-action="Index">Назад</a>
    </div>
    <div class="col-auto">
        <a class="btn btn-primary text-light" asp-action="Create">Добавить</a>
    </div>
</div>
<div class="text-center h4 mb-3">Домашние животные</div>
@if (Model != null)
{
    foreach (var pet in Model)
    {
        count++;
        <div class="border border-4 rounded-3 mb-3">
            <table class="table m-0">
                <tbody>
                    <tr>
                        <td class="ps-3">
                            <image src="Pets/Image?pet=@count" class="img-fluid pet-image-sm "></image>
                        </td>
                        <td class="align-middle">
                            <div class="h5">Имя: @pet.Name</div>
                            <div class="h5">Пол: @pet.Sex</div>
                            <div class="h5">Возраст: @pet.Age</div>
                            <div class="h5">Особенности: @pet.Features</div>
                        </td>
                        <td class="align-middle ">
                            <div class="row align-self-center m-1">
                                <a class="btn btn-info" asp-action="Details" asp-route-pet="@pet.Id">Подробнее</a>
                            </div>
                                    <div class="row align-self-center m-1">
                                <a class="btn btn-primary" asp-action="Edit" asp-route-pet="@pet.Id">Изменить</a>
                            </div>
                                    <div class="row align-self-center m-1">
                                <a class="btn btn-danger" asp-action="Delete" asp-route-pet="@pet.Id">Удалить</a>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}