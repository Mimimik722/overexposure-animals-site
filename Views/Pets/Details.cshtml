@model PetModel;
@{
    ViewData["Title"] = "Описание";
}
<div class="row mb-3">
    <div class="col-auto">
        @if (Context.User.IsInRole("Sitter"))
        {
            <a class="btn btn-primary text-light" asp-controller="Orders" asp-action="New">Назад</a>
        }
        else
        {
            <a class="btn btn-primary text-light" asp-action="Index">Назад</a>
        }
    </div>
    <div class="h4 text-center">Описание для @Model.Name</div>
</div>
<div class="row">
    <div class="col-4">
        <div class="row mb-3">
            <div class="col d-flex align-items-center">
                <label class="form-label m-0">Имя: @Model.Name</label>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col d-flex align-items-center">
                <label class="form-label col-auto m-0">Порода: @Model.Breed_.Name</label>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col d-flex align-items-center">
                <label class="form-label m-0">Пол: @Model.Sex</label>
            </div>
        </div>
        <div class="row align-itemns-center mb-3">
            <div class="col">
                <label class="form-label">Возраст: @Model.Age</label>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col d-flex align-items-center">
                <label class="form-label m-0">Вес: @Model.Weight</label>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col d-flex align-items-center">
                <label class="form-label m-0">Особенности: @Model.Features</label>
            </div>
        </div>
    </div>
    <div class="col">
        <img src="/Pets/Image?pet=@Context.Request.Query.First().Value" class="profile-image image-fulid" alt="Изображение животного" />
    </div>
</div>