@model PetModel;
@{
    ViewData["Title"] = "Описание";
}
<div class="text-left">
    <div class="row mb-3">
        <div class="col-auto">
            @if (Context.User.IsInRole("Sitter"))
            {
                <a class="btn btn-primary text-light" asp-controller="Orders" asp-action="New">Назад</a>
            }
            else
            {
                <a class="btn btn-primary text-light" asp-action="Index">Назад</a>
            }
        </div>
        <div class="h4 text-center">Описание для @Model.Name</div>
    </div>
    <div class="row mb-3">
        <div class="col-1 d-flex align-items-center">
            <label class="form-label m-0">Имя:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.Name</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-1 d-flex align-items-center">
            <label class="form-label col-auto m-0">Порода:</label>
        </div>
        <div class="col-auto">
            <span class="form-label col m-0">@Model.Breed_.Name</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-1 d-flex align-items-center">
            <label class="form-label m-0">Пол:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.Sex</span>
        </div>
    </div>
    <div class="row align-itemns-center mb-3">
        <div class="col-1">
            <label class="form-label">Возраст:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.Age</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-1 d-flex align-items-center">
            <label class="form-label m-0">Вес:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.Weight</span>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-1 d-flex align-items-center">
            <label class="form-label m-0">Особенности:</label>
        </div>
        <div class="col-auto d-flex align-items-center">
            <span class="form-label col m-0">@Model.Features</span>
        </div>
    </div>
</div>