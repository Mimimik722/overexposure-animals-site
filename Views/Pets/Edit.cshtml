@model PetModel;
@{
    ViewData["Title"] = "Изменение";
}
<div class="text-left">
    <form class="form-control" method="post">
        <div class="row mb-3">
            <div class="col-auto">
                <a class="btn btn-primary text-light" asp-action="Index">Назад</a>
            </div>
        </div>
        <div class="form-label col-form-label">Изменение данных для @Model.name</div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Имя:</label>
            </div>
            <div class="col-auto">
                <input class="form-control m-0" type="name" asp-for=name/>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label col-auto m-0">Порода:</label>
            </div>
            <div class="col-auto">
                <input class="form-control m-0" list="breedlistOptions" type="list" name="breed" value="@Model.breed_.name" required>
                <datalist id="townlistOptions">
                    @foreach (var breed in @ViewBag.Breeds)
                    {
                        <option value="@breed.name"></option>
                    }
                </datalist>
                <span class="text-danger" asp-validation-for=breed_></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Пол:</label>
            </div>
            <div class="form-check form-check-inline col-auto">
                    @if (Model.sex == "м")
                    {
                    <input class="form-check-input" type="radio" name="radioM" id="radio1" checked>
                    }
                    else
                    {
                    <input class="form-check-input" type="radio" name="radioM" id="radio1">
                    }
                <label class="form-check-label" for="radio1">М</label>
            </div> 
            <div class="form-check form-check-inline col-auto">
                   @if (Model.sex == "ж")
                   {
                   <input class="form-check-input" type="radio" name="radioW" id="radio2" checked>
                   }
                   else
                   {
                   <input class="form-check-input" type="radio" name="radioW" id="radio2">
                   }
                <label class="form-check-label" for="radio2">Ж</label>
            </div>
        </div>
        <div class="row align-itemns-center mb-3">
            <div class="col-auto">
                <label class="form-label">Возраст:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input class="form-control m-0" type="name" asp-for=age/>
                <span class="text-danger" asp-validation-for=age></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Вес:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input class="form-control m-0" type="name" asp-for=weight/>
                <span class="text-danger" asp-validation-for=weight></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Особенности:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input class="form-control m-0" type="name" asp-for=features/>
            </div>
        </div>
        <input class="btn btn-success" type="submit" value="Сохранить"/>
    </form>
</div>