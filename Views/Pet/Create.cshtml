@model PetModel;
@{
    ViewData["Title"] = "Изменение";
}
<div class="text-left">
    <form class="form-control" method="post">
        <div class="row mb-3">
            <div class="col-auto">
                <a class="btn btn-primary text-light" asp-action="Index">Назад</a>
            </div>
        <div class="form-label col-form-label">Добавление нового домашнего животного</div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Имя:</label>
            </div>
            <div class="col-auto">
                <input type="name" asp-for=name/>
                <span class="text-danger" asp-validation-for=name></span>
            </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label col-auto m-0">Порода:</label>
            </div>
            <div class="col-auto">
                <input class="form-control m-0" list="breedlistOptions" type="list" name="breed" required>
                <datalist id="breedlistOptions">
                    @foreach (var breed in @ViewBag.Breeds)
                    {
                        <option value="@breed.name"></option>
                    }
                </datalist>
                <span class="text-danger" asp-validation-for=breed_></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Пол:</label>
            </div>
            <div class="form-check form-check-inline col-auto">
                <input class="form-check-input" type="radio" name="radioM" id="radio1" checked>
                <label class="form-check-label" for="radio1">М</label>
            </div> 
            <div class="form-check form-check-inline col-auto">
                <input class="form-check-input" type="radio" name="radioW" id="radio2">
                <label class="form-check-label" for="radio2">Ж</label>
            </div>
        </div>
        <div class="row align-itemns-center mb-3">
            <div class="col-auto">
                <label class="form-label">Возраст:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input type="age" asp-for=age/>
                <span class="text-danger" asp-validation-for=age></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Вес:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input asp-for=weight/>
                <span class="text-danger" asp-validation-for=weight></span>
            </div>
        </div>
        <div class="row mb-3">
            <div class="col-auto d-flex align-items-center">
                <label class="form-label m-0">Особенности:</label>
            </div>
            <div class="col-auto d-flex align-items-center">
                <input asp-for=features/>
            </div>
        </div>
        <input class="btn btn-success" type="submit" value="Добавить"/>
    </form>
</div>