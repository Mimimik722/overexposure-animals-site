@model IEnumerable<UserChatHistory>
@{
    string loginUserId = ViewData["loginUserId"].ToString();
}
@if (Model.Any())
{
    foreach (var chat in Model)
    {
        if (chat.Sender_.Id.ToString() == loginUserId)
        {
            //Если отправитель - мы, то все наши сообщения отображаются справа
            <li class="right">
                <div class="text">
                    <div class="user">
                        <i class="fa fa-user-circle-o" aria-hidden="true"></i> @chat.Sender_.Name
                    </div>
                    <small>@chat.Message</small>
                </div>
            </li>
        }
        else
        {
            <li class="left">
                <div class="text">
                    <div class="user">
                        <i class="fa fa-user-circle-o" aria-hidden="true"></i> @chat.Sender_.Name
                    </div>
                    <small>@chat.Message</small>
                </div>
            </li>
        }
    }
}