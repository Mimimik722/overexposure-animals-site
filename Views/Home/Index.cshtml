@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Pet-master</h1>
    <p>Заботимся о вашем питомце пока вы заняты</p>
    @if (ViewBag.pets is not null)
	{
        int count = 1;
        <div class="h3 text-center mt-3 mb-3">Новый заказ</div>
        <div class="form-label col-form-label h4">Выберите животное:</div>
        <table class="table table-bordered">
            <tr>
                <td>№</td>
                <td>Имя</td>
                <td>Порода</td>
                <td>Пол</td>
                <td>Возраст</td>
                <td>Вес</td>
                <td>Особенности</td>
                <td>Действия</td>
            </tr>
            @foreach (var pet in ViewBag.pets)
	    	{
	    		count++;
                <tr class="align-middle">
                    <td>@count</td>
                    <td>@pet.Name</td>
                    <td>@pet.Breed_.Name</td>
                    <td>@pet.Sex</td>
                    <td>@pet.Age</td>
                    <td>@pet.Weight</td>
                    <td>@pet.Features</td>
                    <td>
                        <a class="btn btn-primary" asp-controller="Orders" asp-action="Create" asp-route-pet="@pet.Id">Выбрать</a>
                    </td>
                </tr>
	    	}
        </table>
    }
    else
    {
        <div class="h4 text-center mt-3 mb-3">К сожалению, доступных животных нет. Войдите и добавьте своего питомца, чтобы сделать заказ.</div>
    }
</div>
